MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=deepfake_detection

# Detector backend options: huggingface or local
IMAGE_DETECTOR_BACKEND=huggingface
IMAGE_HF_MODEL_IDS=pretrained_model/huggingface/buildborderless__CommunityForensics-DeepfakeDet-ViT
IMAGE_FAKE_THRESHOLD=0.5
IMAGE_UNCERTAIN_MARGIN=0.12

VIDEO_DETECTOR_BACKEND=huggingface
VIDEO_HF_MODEL_ID=pretrained_model/huggingface/Vansh180__VideoMae-ffc23-deepfake-detector
VIDEO_NUM_FRAMES=16
VIDEO_FAKE_THRESHOLD=0.5
VIDEO_UNCERTAIN_MARGIN=0.12

# Use cpu unless you deploy to a CUDA-enabled host.
DETECTOR_DEVICE=cpu
ALLOW_LOCAL_MODEL_FALLBACK=true
